# --- Data (MILK10k is ~GBs of images; download it locally, never commit it) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.zip
*.tar
*.tar.gz
*.crdownload
*.part
*.csv
*.parquet

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets ---
.env
*.pem
